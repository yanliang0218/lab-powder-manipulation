<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>

<package format="3">
  <name>arm_v2_description</name>
  <version>0.0.0</version>
  <description>
    Robot description, encoder bridge, forward-kinematics tools, camera data
    acquisition, synchronized image/FK packaging, and offline eye-in-hand
    calibration for the Arm V2 platform.
  </description>

  <maintainer email="yanliangca@126.com">stephen</maintainer>
  <license>MIT</license>

  <!-- ====================================================================== -->
  <!-- Build system                                                           -->
  <!-- ====================================================================== -->

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Required at build time to generate the custom SyncedMsg interface.     -->
  <build_depend>rosidl_default_generators</build_depend>

  <!-- Required at runtime by programs that use the generated messages.       -->
  <exec_depend>rosidl_default_runtime</exec_depend>

  <!-- ROS 2 interface packages must identify themselves as members of this    -->
  <!-- group when they generate custom .msg/.srv/.action files.               -->
  <member_of_group>rosidl_interface_packages</member_of_group>

  <!-- ====================================================================== -->
  <!-- C++ nodes, KDL, TF and message dependencies                            -->
  <!-- ====================================================================== -->

  <depend>rclcpp</depend>

  <depend>kdl_parser</depend>
  <depend>orocos_kdl_vendor</depend>

  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>

  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>

  <!-- ====================================================================== -->
  <!-- Launch, robot model and visualization runtime dependencies             -->
  <!-- ====================================================================== -->

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <!-- ====================================================================== -->
  <!-- USB camera and compressed image transport                              -->
  <!-- ====================================================================== -->

  <exec_depend>usb_cam</exec_depend>
  <exec_depend>image_transport</exec_depend>
  <exec_depend>image_transport_plugins</exec_depend>

  <!-- ====================================================================== -->
  <!-- Offline Python calibration and rosbag processing                       -->
  <!-- ====================================================================== -->

  <exec_depend>rclpy</exec_depend>
  <exec_depend>rosbag2_py</exec_depend>
  <exec_depend>rosidl_runtime_py</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-numpy</exec_depend>

  <!-- pupil_apriltags is a Python package rather than a normal ROS package.   -->
  <!-- Install it in the same Python environment as rclpy with pip.            -->

  <!-- ====================================================================== -->
  <!-- Test dependencies                                                      -->
  <!-- ====================================================================== -->

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>

